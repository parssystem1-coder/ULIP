# Application
NODE_ENV=development
APP_NAME=ulip
APP_PORT=3001
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ulip

# Redis
REDIS_URL=redis://localhost:6379

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ulip
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Authentication
AUTH_SECRET=replace-me

# AI providers (placeholders; never commit real keys)
LLM_PROVIDER=
LLM_API_KEY=
VISION_PROVIDER=
VISION_API_KEY=
JEV_PROVIDER=
JEV_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
