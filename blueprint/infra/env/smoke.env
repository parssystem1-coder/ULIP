# ULIP runtime smoke/integration env (Phase 14).
# Dev placeholders only — never put real secrets here.
# Usage:
#   docker compose -f infra/docker/docker-compose.runtime.yml up -d postgres
#   pnpm migrate   (ULIP_PG_URL=postgresql://postgres:postgres@localhost:5433/ulip)
#   start api + worker with this env, then:
#   set -a; source infra/env/smoke.env; set +a
#   ULIP_IT_WORKER=1 node --experimental-strip-types --test apps/api/test/integration.api.test.ts
NODE_ENV=development
APP_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ulip
REDIS_URL=redis://localhost:6379
AUTH_SECRET=dev-auth-secret-change-me
BOOTSTRAP_API_KEY=dev-bootstrap-key-change-me!!
LOG_LEVEL=info
